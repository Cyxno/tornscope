{
  "name": "tornscope",
  "version": "0.1.3",
  "private": true,
  "description": "TornScope - self-hostable Torn.com analytics and history portal",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @tornscope/web build",
    "dev": "concurrently -k -n tsc,api,worker,web -c gray,cyan,magenta,blue \"tsc -b --watch\" \"pnpm --filter @tornscope/api dev\" \"pnpm --filter @tornscope/worker dev\" \"pnpm --filter @tornscope/web dev\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "db:generate": "pnpm --filter @tornscope/database generate",
    "db:migrate": "pnpm --filter @tornscope/database migrate:deploy",
    "db:studio": "pnpm --filter @tornscope/database studio",
    "seed:demo": "pnpm --filter @tornscope/database seed:demo",
    "lint": "eslint .",
    "torn:audit": "pnpm --filter @tornscope/database run audit",
    "torn:renormalize": "pnpm --filter @tornscope/database renormalize",
    "verify": "pnpm lint && pnpm typecheck && pnpm --filter @tornscope/web exec svelte-check --tsconfig ./tsconfig.json && pnpm test && pnpm build && docker compose config --quiet",
    "check:web": "pnpm --filter @tornscope/web exec svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.5.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "prisma": "^6.16.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.4"
  }
}
