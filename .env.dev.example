# TornScope DEVELOPMENT / STAGING environment — template.
#
# Copy to .env.dev (in the dedicated develop checkout) and fill in fresh
# secrets. NEVER copy the production .env here, and NEVER commit .env.dev.
#
#   cp .env.dev.example .env.dev
#   # then generate real values:
#   #   POSTGRES_PASSWORD, API_KEY_ENCRYPTION_KEY  ->  openssl rand -hex 32
#   #   VAPID keys                                 ->  npx web-push generate-vapid-keys
#
# Deploy with: scripts/deploy-dev.sh  (runs from the develop checkout,
# uses docker-compose.dev.yml + .env.dev, project name tornscope-dev).

# --- Dev database (completely separate from production) ---
POSTGRES_USER=tornscope_dev
POSTGRES_PASSWORD=CHANGE_ME_DEV_DB_PASSWORD_64_HEX
POSTGRES_DB=tornscope_dev

# Dev-only master key for stored Torn API keys (AES-256-GCM, 32 bytes hex).
# NOTE: this must differ from production. If you ever restore a PRODUCTION
# database copy into the dev stack for migration rehearsal, stored API keys
# can only be decrypted with the production key — see
# docs/DATABASE-MIGRATIONS.md before doing that.
API_KEY_ENCRYPTION_KEY=CHANGE_ME_DEV_ENCRYPTION_KEY_64_HEX

# --- Dev public origin (private staging domain behind NPM access control) ---
APP_BASE_URL=https://torn.familievalk.com
ORIGIN=https://torn.familievalk.com
PUBLIC_BASE_URL=https://torn.familievalk.com
ALLOWED_ORIGINS=https://torn.familievalk.com

# --- Proxy chain: visitor -> Cloudflare -> NPM -> web (same as prod) ---
TRUST_PROXY=true
# XFF chain at the web container is [spoofable..., visitor, CF edge];
# depth 2 = the real visitor.
CLIENT_IP_HEADER=x-forwarded-for
CLIENT_IP_DEPTH=2

# --- Push notifications: use DEV-ONLY VAPID keys, never the prod pair ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev-alerts@familievalk.local

# --- Sync behaviour (defaults tuned to be gentle on api.torn.com) ---
TORN_API_MIN_REQUEST_INTERVAL_MS=1500
TORN_SYNC_INITIAL_HISTORY_DAYS=180
TODAY_CACHE_TTL_MS=30000
LOG_LEVEL=info
GUEST_PROFILE_RETENTION_DAYS=60

# --- Visible environment marker in the UI (empty = show "Beta") ---
PUBLIC_ENV_LABEL=Development

# --- Hosted-instance limits (roadmap #8) ------------------------------------
# Abuse bounds for a publicly reachable instance. Defaults suit a public
# beta; loosen for a trusted self-hosted LAN. Security basics (auth, CSRF,
# SSRF, isolation) never depend on these.
# Active sessions allowed per profile (stalest revoked beyond the cap).
HOSTED_MAX_SESSIONS_PER_PROFILE=10
# Anonymous profile creations per IP per hour.
HOSTED_PROFILE_CREATIONS_PER_IP_PER_HOUR=20
# Active push devices per profile (clear error at the cap, never eviction).
HOSTED_MAX_PUSH_DEVICES=10
