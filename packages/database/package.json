{
  "name": "@tornscope/database",
  "version": "2.0.5",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "studio": "prisma studio",
    "seed:demo": "prisma migrate deploy && tsx src/seed/demo.ts",
    "audit": "tsx src/audit/audit.ts",
    "renormalize": "tsx src/renormalize/renormalize.ts",
    "topup:demo": "tsx src/demo/topup-cli.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@tornscope/analytics": "workspace:*",
    "@tornscope/shared": "workspace:*",
    "@tornscope/torn-api": "workspace:*",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "prisma": "^6.16.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
