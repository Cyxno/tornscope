// TornScope database schema.
//
// Design principles:
// - Historical data is a first-class concern: events (individual historical
//   occurrences) and snapshots (state at a point in time) are separated.
// - Unique constraints on (user_id, source, source_ref) make ingestion
//   idempotent so workers can safely re-run after downtime.
// - Indexes on (user_id, occurred_at / captured_at) serve the analytics reads.
// - JSONB only stores raw Torn payloads for reference; commonly queried fields
//   are normalized columns.
// - Money amounts use BigInt (Prisma BigInt / Postgres bigint) and are
//   converted to JS numbers at the API boundary.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/client"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MoneyDirection {
  income
  expense
  neutral
  /// Money movement observed but not yet classified (e.g. unmapped log
  /// titles). Excluded from income/expense aggregates until classified.
  unknown
}

enum DrugOutcome {
  success
  overdose
}

enum TravelItemCategory {
  plushie
  flower
  xanax
  other
}

/* -------------------------------------------------------------------------- */
/* Identity & credentials                                                     */
/* -------------------------------------------------------------------------- */

/// Application user. MVP ships single-user (a local owner account), but the
/// schema and services are multi-user ready (every table scopes by user_id).
model User {
  id          String   @id @default(cuid())
  email       String?  @unique
  displayName String
  role        String   @default("owner")
  isDemo      Boolean  @default(false)
  timezone    String   @default("UTC")
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tornAccount          TornAccount?
  apiCredential        ApiCredential?
  syncStates           SyncState[]
  syncRuns             SyncRun[]
  userSnapshots        UserSnapshot[]
  personalStatSnapshot PersonalStatSnapshot[]
  barsSnapshots        BarsSnapshot[]
  networthSnapshots    NetworthSnapshot[]
  drugEvents           DrugEvent[]
  consumptionEvents    ConsumptionEvent[]
  crimeEvents          CrimeEvent[]
  combatEvents         CombatEvent[]
  rehabEvents          RehabEvent[]
  syncCategoryStates   SyncCategoryState[]
  travelEvents         TravelEvent[]
  travelItemEvents     TravelItemEvent[]
  travelTransitions    TravelTransition[]
  moneyEvents          MoneyEvent[]
  timelineEvents       TimelineEvent[]
  factionMemberships   FactionMembership[]
  factionSnapshots     FactionSnapshot[]
  factionArmoryEvents  FactionArmoryEvent[]
  sessions             UserSession[]
  rankedWarMembers     RankedWarMember?
  rankedWarPayouts     RankedWarPayout[]
  factionChains        FactionChain[]
  organizedCrimes      OrganizedCrime[]
  factionBalanceSnapshots FactionBalanceSnapshot[]
  pushSubscriptions    PushSubscription[]
  notificationPreference NotificationPreference?
  notificationState    NotificationState?
  notificationDeliveries NotificationDelivery[]
}

/// The Torn player connected to a user.
model TornAccount {
  id             String    @id @default(cuid())
  userId         String    @unique
  tornId         Int
  /// True only for the synthetic demo identity, which sits outside the
  /// one-real-tornId-per-profile invariant (partial unique index).
  isDemo         Boolean   @default(false)
  name           String
  level          Int
  rank           String?
  donatorStatus  Int?
  gender         String?
  property       String?
  factionId      Int?
  status         Json?
  firstSeenAt    DateTime
  lastSeenAt     DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([factionId])
  @@index([tornId])
}

/// AES-256-GCM encrypted Torn API key. Never stored or logged in plaintext.
model ApiCredential {
  id                 String    @id @default(cuid())
  userId             String    @unique
  encryptedKey       String
  iv                 String
  authTag            String
  keyPreview         String
  accessLevel        Int?
  accessType         String?
  logAccessAvailable Boolean
  /// Detected key capabilities (selections the key can actually read).
  capabilities       Json?
  validatedAt        DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/* -------------------------------------------------------------------------- */
/* Synchronization                                                            */
/* -------------------------------------------------------------------------- */

/// Anonymous browser-bound session. The browser holds only an opaque token
/// (HttpOnly cookie); the server stores its hash and the profile it resolves
/// to. Sessions are revoked when the profile is deleted.
model UserSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One row per (user, resource) tracking incremental sync progress.
model SyncState {
  id               String    @id @default(cuid())
  userId           String
  resource         String
  frequencySeconds Int       @default(600)
  status           String    @default("idle")
  lastAttemptAt    DateTime?
  lastStartedAt    DateTime?
  /// Liveness heartbeat for the current run, written ONLY by claim and the
  /// progress heartbeat — never by generic bookkeeping updates. Stale-run
  /// recovery keys off this so schedule updates cannot mask a dead worker.
  lastHeartbeatAt  DateTime?
  lastCompletedAt  DateTime?
  lastSuccessAt    DateTime?
  nextRunAt        DateTime?
  lastTimestamp    BigInt?
  cursor           String?
  recordsCollected Int       @default(0)
  errorCount       Int       @default(0)
  errorMessage     String?
  /// Machine reason code of the last failure (NEVER raw prose): torn error
  /// kinds (rate_limited | transient | network | access_denied | key_invalid
  /// | key_paused | permanent) or operational reasons (worker_interrupted |
  /// category_failure). Cleared on success. Drives retry/degraded wording —
  /// raw errorMessage stays server-side and is never shipped as a code.
  lastErrorKind    String?
  /// Why the historical (backward) pagination last stopped:
  /// history_boundary_reached | source_exhausted | max_pages | cursor_stalled
  /// | api_error | null (never ran a backward walk).
  stopReason       String?
  /// Oldest timestamp the source still exposes within the requested window,
  /// observed during the last backward walk ("available from Torn").
  sourceEarliestAt BigInt?
  /// Torn API pages fetched by the last sync — verifies incremental syncs
  /// stay lightweight vs the initial backfill.
  lastWalkPages    Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource])
  @@index([status])
  @@index([nextRunAt])
}

/// Per-category incremental cursor for log resources (money, drugs, travel,
/// rehab, events).
///
/// CURSOR SEMANTICS — a category's lastTimestamp means:
///   "all log rows above this successfully persisted point are known to be
///    stored" (minus the cursor overlap window, which is re-fetched each
///    cycle to protect same-second rows straddling a page boundary).
/// It is advanced only AFTER a category's page data has been normalized and
/// inserted; a crash mid-walk leaves the previous cursor intact and the next
/// run replays safely (insertion is idempotent via (userId, source, sourceRef)).
///
/// Torn has no server-side lower-bound filter, so an incremental walk pages
/// down from the newest page until it reaches the category's own cursor —
/// most low-volume categories need exactly one page.
model SyncCategoryState {
  id                  String   @id @default(cuid())
  userId              String
  resource            String
  categoryId          Int
  /// Catalog title at creation time (display only).
  categoryTitle       String?
  /// active | access_denied | source_exhausted | failed
  status              String   @default("active")
  /// Incremental watermark (see model comment).
  lastTimestamp       BigInt?
  lastSuccessAt       DateTime?
  lastWalkPages       Int?
  lastRecordsInserted Int?
  /// Oldest source row observed for this category (backfill depth).
  sourceEarliestAt    BigInt?
  errorMessage        String?
  /// Adaptive per-category scheduling (policy in worker/sync/schedule.ts).
  nextRunAt           DateTime?
  frequencySeconds    Int?
  /// Last walk that actually found rows above the category cursor.
  lastActivityAt      DateTime?
  consecutiveEmptyRuns Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, categoryId])
  @@index([userId, resource])
  @@index([nextRunAt])
}

/// Append-only history of sync attempts (drives the Sync Status page).
model SyncRun {
  id               String    @id @default(cuid())
  userId           String
  resource         String
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  status           String
  recordsCollected Int       @default(0)
  errorMessage     String?
  /// Adaptive-scheduling metrics: categoriesDue, categoriesProcessed,
  /// categoriesSkipped, pagesWalked, apiCallsEstimate.
  stats            Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, resource, startedAt])
}

/* -------------------------------------------------------------------------- */
/* Snapshots (state at a point in time)                                       */
/* -------------------------------------------------------------------------- */

/// Player state snapshot, inserted on profile sync when state changed.
model UserSnapshot {
  id         String   @id @default(cuid())
  userId     String
  capturedAt DateTime
  level      Int
  rank       String?
  factionId  Int?
  status     Json?
  raw        Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capturedAt])
  @@index([userId, capturedAt])
}

/// Long-term personal stats snapshot (hourly/daily).
model PersonalStatSnapshot {
  id            String   @id @default(cuid())
  userId        String
  capturedAt    DateTime
  networthTotal BigInt?
  stats         Json

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capturedAt])
  @@index([userId, capturedAt])
}

/// Energy and happy bar snapshot (5-minute cadence) — the ONLY historical
/// record of bar state; Torn exposes bars live-only. Captured going forward
/// from first sync; there is no retroactive history (docs/PROGRESSION-ENERGY.md).
model BarsSnapshot {
  id            String   @id @default(cuid())
  userId        String
  capturedAt    DateTime
  energyCurrent Int
  energyMaximum Int
  happyCurrent  Int
  happyMaximum  Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capturedAt])
  @@index([userId, capturedAt])
}

/// Net worth snapshot with Torn-provided category breakdown.
model NetworthSnapshot {
  id          String   @id @default(cuid())
  userId      String
  capturedAt  DateTime
  total       BigInt
  pending     BigInt   @default(0)
  wallet      BigInt   @default(0)
  vault       BigInt   @default(0)
  bookie      BigInt   @default(0)
  cityBank    BigInt   @default(0)
  caymanBank  BigInt   @default(0)
  piggyBank   BigInt   @default(0)
  loans       BigInt   @default(0)
  unpaidFees  BigInt   @default(0)
  inventory   BigInt   @default(0)
  displayCase BigInt   @default(0)
  bazaar      BigInt   @default(0)
  trades      BigInt   @default(0)
  itemMarket  BigInt   @default(0)
  auctionHouse BigInt  @default(0)
  enlistedCars BigInt  @default(0)
  property    BigInt   @default(0)
  stockMarket BigInt   @default(0)
  company     BigInt   @default(0)
  points      BigInt   @default(0)
  raw         Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capturedAt])
  @@index([userId, capturedAt])
}

/* -------------------------------------------------------------------------- */
/* Events (individual historical occurrences)                                 */
/* -------------------------------------------------------------------------- */

/// Drug use events derived from Torn logs.
model DrugEvent {
  id         String      @id @default(cuid())
  userId     String
  occurredAt DateTime
  drugItemId Int?
  drugName   String?
  outcome    DrugOutcome
  source     String      @default("torn_log")
  sourceRef  String
  raw        Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceRef])
  @@index([userId, occurredAt])
  @@index([userId, drugItemId])
}

/// Normalized crime attempt from Torn crime logs.
///
/// Success/failure comes from the log title; money_gained/money_lost from the
/// payload. The cash side is ALSO written to MoneyEvent (category crime) by
/// the same normalization pass — exactly one ledger row per money-bearing
/// crime log, so Crimes analytics and the Economy ledger always agree.
/// Nerve, when present, is exact; item rewards are valued from the Torn item
/// catalog (estimated) and never invented.
model CrimeEvent {
  id            String   @id @default(cuid())
  userId        String
  sourceRef     String
  occurredAt    DateTime
  /// Torn outcome id from the payload (stable per outcome, opaque).
  crimeId       Int?
  crimeName     String?
  /// Legacy | New crime system, derived from the title shape.
  crimeCategory String?
  success       Boolean
  nerveUsed     Int?
  moneyDelta    BigInt?
  itemsValue    BigInt?
  jailSeconds   Int?
  hospitalSeconds Int?
  skillGain     Int?
  metadata      Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceRef])
  @@index([userId, occurredAt])
  @@index([userId, success])
}

/// Normalized combat event from the /v2/user/attacks endpoint.
///
/// direction: outgoing (user attacked) | incoming (user was attacked),
/// decided by which side of the payload names the account. Opponent may be
/// unknown (Torn nulls some attacker profiles) — rendered as
/// "Unknown opponent", never fabricated. Mug cash is NOT duplicated here:
/// it lives in MoneyEvent (category mugging) from the mug logs.
model CombatEvent {
  id              String   @id @default(cuid())
  userId          String
  sourceRef       String
  occurredAt      DateTime
  direction       String
  opponentId      Int?
  opponentName    String?
  result          String
  attackType      String?
  moneyDelta      BigInt?
  respectDelta    Float?
  hospitalSeconds Int?
  modifiers       Json?
  metadata        Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceRef])
  @@index([userId, occurredAt])
  @@index([userId, direction])
}

/// Value of consumed (used-up) items: drugs, boosters, medical items, energy
/// drinks, candy, happy-jump items (EDVD) and other consumables.
///
/// Consumption is deliberately SEPARATE from MoneyEvent cash flow: the
/// purchase is a real cash movement (MoneyEvent, expense); the later use
/// consumes value without any further cash movement. The two are never
/// summed into one "profit" figure.
model ConsumptionEvent {
  id              String   @id @default(cuid())
  userId          String
  occurredAt      DateTime
  itemId          Int?
  itemName        String?
  /// drug | booster | medical | energy | candy | happy_jump | temporary | other
  category        String
  quantity        Int      @default(1)
  /// Per-unit consumed value when a price source was available.
  unitValue       BigInt?
  totalValue      BigInt?
  /// acquisition_cost | market_price | catalog_market_price | unknown
  valuationMethod String   @default("unknown")
  /// exact | derived | estimated | unknown
  provenance      String   @default("unknown")
  /// torn_log (normalized directly) | derived_drug_event (from DrugEvent data)
  source          String   @default("torn_log")
  sourceRef       String
  metadata        Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceRef])
  @@index([userId, occurredAt])
  @@index([userId, category])
}

/// Rehabilitation visits. One row = one visit; `sessions` is the explicit
/// `rehab_times` count from Torn (sessions purchased during the visit).
model RehabEvent {
  id                    String   @id @default(cuid())
  userId                String
  occurredAt            DateTime
  rehabPercent          Int?
  cost                  BigInt?
  /// Explicit session count from Torn (`rehab_times`); null when the source
  /// payload did not carry it — rendered "Sessions unavailable", never 1.
  sessions              Int?
  addictionPointsRemoved Int?
  source                String   @default("torn_log")
  sourceRef             String
  raw                   Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceRef])
  @@index([userId, occurredAt])
}

/// Flights (departure/arrival/return lifecycle).
///
/// Since the travel rebuild, rows are ASSEMBLED TRIPS built from
/// TravelTransition evidence (source = "trip"), not one-per-log fragments.
/// destination/departedAt/arrivedAt/returnedAt are only filled from real
/// chronological transitions — departedAt is never fabricated from an
/// arrival timestamp.
model TravelEvent {
  id              String    @id @default(cuid())
  userId          String
  destination     String
  departedAt      DateTime
  arrivedAt       DateTime?
  returnedAt      DateTime?
  durationSeconds Int?
  status          String    @default("unknown")
  source          String    @default("torn_log")
  sourceRef       String
  raw             Json?

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemPurchases TravelItemEvent[]

  @@unique([userId, source, sourceRef])
  @@index([userId, departedAt])
  @@index([userId, destination])
}

/// Items purchased while abroad (plushies, flowers, other).
model TravelItemEvent {
  id                  String             @id @default(cuid())
  userId              String
  travelEventId       String?
  occurredAt          DateTime
  destination         String?
  category            TravelItemCategory
  itemId              Int
  itemName            String?
  quantity            Int
  unitCost            BigInt
  totalCost           BigInt
  estimatedUnitValue  BigInt?
  estimatedTotalValue BigInt?
  realizedUnitValue   BigInt?
  realizedTotalValue  BigInt?
  source              String             @default("torn_log")
  sourceRef           String
  raw                 Json?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  travelEvent TravelEvent? @relation(fields: [travelEventId], references: [id], onDelete: SetNull)

  @@unique([userId, source, sourceRef])
  @@index([userId, occurredAt])
  @@index([userId, category])
  @@index([itemId])
}

/// Step A of the travel model: an individual travel transition parsed from a
/// single Torn log entry. Trips (TravelEvent, source="trip") are assembled
/// from these in chronological order — never fabricated per log.
model TravelTransition {
  id        String   @id @default(cuid())
  userId    String
  occurredAt DateTime
  type      String
  /// Resolved country name (empty string when unknown/unresolvable).
  country   String?
  /// Numeric Torn country id from the raw payload, kept for re-mapping.
  countryId Int?
  source    String   @default("torn_log")
  sourceRef String
  metadata  Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceRef])
  @@index([userId, occurredAt])
  @@index([userId, type])
}

/// Central normalized financial ledger (single source of truth for money).
model MoneyEvent {
  id           String        @id @default(cuid())
  userId       String
  occurredAt   DateTime
  category     String
  subcategory  String?
  direction    MoneyDirection
  amount       BigInt
  source       String
  sourceRef    String
  description  String?
  metadata     Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceRef])
  @@index([userId, occurredAt])
  @@index([userId, category])
}

/// Unified chronological timeline entries.
model TimelineEvent {
  id          String   @id @default(cuid())
  /// Monotonic insertion sequence (notification cursor). NOT event time.
  seq         BigInt   @default(autoincrement()) @unique
  userId      String
  occurredAt  DateTime
  type        String
  category    String?
  title       String
  description String?
  amount      BigInt?
  metadata    Json?
  source      String
  sourceRef   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceRef])
  @@index([userId, occurredAt])
  @@index([userId, type])
}

/* -------------------------------------------------------------------------- */
/* Faction foundation                                                         */
/* -------------------------------------------------------------------------- */

model Faction {
  id        Int      @id
  name      String
  tag       String?
  leaderId  Int?
  coLeaderId Int?
  respect   Int?
  daysOld   Int?
  capacity  Int?
  members   Int?
  bestChain Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships FactionMembership[]
  snapshots   FactionSnapshot[]
  rankedWars  RankedWar[]
}

model FactionMembership {
  id        String    @id @default(cuid())
  userId    String
  factionId Int
  /// The member's Torn player id (null only for rows predating the identity
  /// migration; backfilled from sourceRef where possible).
  memberId  Int?
  name      String?
  position  String?
  level     Int?
  daysInFaction Int?
  lastActionAt  DateTime?
  lastActionStatus String?
  joinedAt  DateTime?
  leftAt    DateTime?
  isActive  Boolean   @default(true)
  sourceRef String
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  faction Faction @relation(fields: [factionId], references: [id])

  @@unique([userId, factionId, sourceRef])
  @@index([userId, isActive])
  @@index([userId, memberId])
}

model FactionSnapshot {
  id         String   @id @default(cuid())
  userId     String
  factionId  Int
  capturedAt DateTime
  members    Int?
  respect    Int?
  raw        Json?

  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  faction Faction @relation(fields: [factionId], references: [id])

  @@unique([userId, capturedAt])
  @@index([factionId, capturedAt])
}

/// Faction armory usage parsed from the faction armory news feed
/// (/v2/faction/news?cat=armoryAction & armoryDeposit). First-class provenance
/// source: determines whether consumed items (e.g. Xanax) were
/// faction-sponsored. Never a DrugUse duplicate.
model FactionArmoryEvent {
  id         String   @id @default(cuid())
  userId     String
  factionId  Int
  /// Torn player id of the acting member (parsed from the news payload).
  memberId   Int?
  memberName String?
  itemId     Int?
  itemName   String?
  /// used | deposited | lent | returned | ... (as reported by the news verb).
  action     String   @default("used")
  quantity   Int      @default(1)
  /// Estimated catalog value of the items at parse time (quantity × price).
  value      BigInt?
  source     String   @default("torn_faction_news")
  sourceRef  String
  occurredAt DateTime
  raw        Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceRef])
  @@index([userId, memberId, occurredAt])
  @@index([userId, itemId])
}

/* -------------------------------------------------------------------------- */
/* Torn item catalog cache (public /torn/items)                               */
/* -------------------------------------------------------------------------- */

model TornItemCatalog {
  itemId      Int      @id
  name        String
  type        String
  marketPrice BigInt?
  updatedAt   DateTime @updatedAt
}

/* -------------------------------------------------------------------------- */
/* Settings                                                                   */
/* -------------------------------------------------------------------------- */

/// Key/value application settings. userId = "" denotes a global setting.
model AppSetting {
  id        String   @id @default(cuid())
  userId    String   @default("")
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  // No FK: userId = "" is a deliberate global scope (dropped by migration
  // 20260905000000_appsetting_drop_user_fk — the FK broke every global write).
  @@unique([userId, key])
}

/* -------------------------------------------------------------------------- */
/* Ranked war foundation (schema-only placeholder, not implemented in MVP)    */
/* -------------------------------------------------------------------------- */

/// Historical faction chain record (/v2/faction/chains).
model FactionChain {
  id        String   @id @default(cuid())
  userId    String
  factionId Int
  chainId   Int
  chain     Int
  respect   Float?
  startedAt DateTime
  endedAt   DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chainId])
  @@index([userId, factionId])
  @@index([userId, startedAt])
}

/// Organized crime record (/v2/faction/crimes, OC 2.0). Participants and
/// rewards are stored as JSON from the exact payload.
model OrganizedCrime {
  id          String   @id @default(cuid())
  userId      String
  factionId   Int
  ocId        Int
  name        String
  difficulty  Int?
  status      String
  createdAt   DateTime?
  planningAt  DateTime?
  executedAt  DateTime?
  readyAt     DateTime?
  expiredAt   DateTime?
  rewards     Json?
  slots       Json?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ocId])
  @@index([userId, factionId])
  @@index([userId, status])
}

/// Faction bank balance snapshot (/v2/faction/balance): faction money and
/// per-member faction-balance rows.
model FactionBalanceSnapshot {
  id         String   @id @default(cuid())
  userId     String
  factionId  Int
  money      BigInt?
  points     Int?
  scope      Int?
  members    Json?
  capturedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, factionId, capturedAt])
}

model RankedWar {
  id               String    @id @default(cuid())
  tornWarId        Int       @unique
  factionId        Int
  opponentFactionId Int?
  opponentName     String?
  startedAt        DateTime?
  endedAt          DateTime?
  winnerFactionId  Int?
  targetScore      Int?
  ourScore         Int?
  opponentScore    Int?
  ourChain         Int?
  opponentChain    Int?
  source           String    @default("torn_api")
  raw              Json?
  createdAt        DateTime  @default(now())

  faction   Faction           @relation(fields: [factionId], references: [id])
  members   RankedWarMember[]
  attacks   RankedWarAttack[]
  payouts   RankedWarPayout[]
}

model RankedWarMember {
  id       String   @id @default(cuid())
  warId    String
  userId   String?  @unique
  tornId   Int
  score    Int?
  hits     Int?
  respect  Int?
  joinedAt DateTime?

  war  RankedWar @relation(fields: [warId], references: [id], onDelete: Cascade)
  user User?     @relation(fields: [userId], references: [id])

  @@unique([warId, tornId])
}

model RankedWarAttack {
  id            String   @id @default(cuid())
  warId         String
  attackerTornId Int
  defenderTornId Int
  occurredAt    DateTime
  result        String?
  respectGained Int?
  raw           Json?

  war RankedWar @relation(fields: [warId], references: [id], onDelete: Cascade)

  @@index([warId, occurredAt])
}

model RankedWarPayout {
  id        String    @id @default(cuid())
  warId     String
  userId    String
  amount    BigInt
  paidAt    DateTime?
  sourceRef String

  war  RankedWar @relation(fields: [warId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceRef])
}

/* -------------------------------------------------------------------------- */
/* Push notifications                                                          */
/* -------------------------------------------------------------------------- */

/// One browser/device Web Push subscription. Belongs to EXACTLY one profile;
/// devices subscribe and are revoked independently.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  /// Web Push endpoint URL (unique per browser registration).
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// Best-effort client description from subscription-time navigator data.
  userAgent String?
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId])
}

/// Per-profile notification preferences + activation boundary. One row per
/// user; created (with enabledAt = now) when push is first enabled, which is
/// the cursor that prevents historical floods.
model NotificationPreference {
  userId           String  @id
  /// Category toggles keyed by canonical category id; absent = default.
  categories       Json
  /// Include amounts/senders in notification bodies. Default OFF (privacy).
  sensitiveDetails Boolean @default(false)
  /// Quiet hours in the user's timezone (minutes since midnight); null = off.
  quietStartMin    Int?
  quietEndMin      Int?
  /// Activation boundary: only events observed after this instant are
  /// eligible for delivery. Set when preferences are first created.
  enabledAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Dedup ledger: one row per delivered (subscription, event, type). The
/// unique constraint makes worker restarts and re-evaluations idempotent.
model NotificationDelivery {
  id               String   @id @default(cuid())
  userId           String
  subscriptionId   String
  eventKey         String
  notificationType String
  sentAt           DateTime @default(now())
  status           String   @default("sent")

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, eventKey, notificationType])
  @@index([userId, sentAt])
}

/// Latest observed live-state snapshot per user (timers diffing). Stores the
/// previous bars/cooldowns/travel/education/bank state so the worker can
/// detect active → ready transitions, plus nextEligibleAt so the engine only
/// queries Torn when a tracked timer can actually have changed.
model NotificationState {
  userId         String   @id
  /// Previous live snapshot (Json): cooldowns, travel, education, bank, bars.
  previousState  Json?
  /// Earliest instant at which re-fetching live state could yield a new
  /// transition. Null = nothing tracked; the engine may fetch on its cadence.
  nextEligibleAt DateTime?
  /// Highest TimelineEvent insertion-sequence evaluated for notifications.
  lastTimelineSeq BigInt   @default(0)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
