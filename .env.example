# TornScope environment configuration
# Copy to .env and adjust. Never commit real secrets.

# --- Docker image version ---------------------------------------------------
# Which published image set to run. Tags are published per release on
# ghcr.io/cyxno (see README "Docker images"):
#   TORNSCOPE_VERSION=2.3.1   exact release — RECOMMENDED for controlled installs
#   TORNSCOPE_VERSION=latest  tracks the current stable release
# Bump this when updating TornScope (README "Updating"). `latest` is only
# moved when a release's web+api+worker images have all published.
TORNSCOPE_VERSION=2.3.1
# Image registry/namespace override — leave as-is unless you mirror the images.
TORNSCOPE_REGISTRY=ghcr.io/cyxno

# --- Database -------------------------------------------------------------
# PostgreSQL — docker compose reads POSTGRES_USER/PASSWORD/DB to provision
# the database container. POSTGRES_PASSWORD is REQUIRED (the compose file
# refuses to start without it). Generate a fresh one per install, e.g.:
#   openssl rand -hex 16        (hex = safe in URIs, no quoting pitfalls)
# The README Quick Start commands do this automatically.
POSTGRES_USER=tornscope
POSTGRES_PASSWORD=
POSTGRES_DB=tornscope
# Leave DATABASE_URL as-is for Docker Compose deploys: the api/worker/migrate
# services get the Docker-internal URL (postgres:5432) from the compose files,
# so this value is not used by them. The localhost default below is for
# local NON-Docker development where Postgres runs directly on your machine.
DATABASE_URL=postgresql://tornscope:tornscope@localhost:5432/tornscope?schema=public

# --- Redis ----------------------------------------------------------------
# Used by BullMQ for the sync queue and rate-limit coordination.
# Docker Compose deploys always use redis://redis:6379 internally (set by the
# compose files); this localhost default is for non-Docker development.
REDIS_URL=redis://localhost:6379

# --- Torn API -------------------------------------------------------------
# Torn API v2 base URL. Only override for testing/proxying.
TORN_API_BASE_URL=https://api.torn.com/v2
# Minimum spacing between outgoing Torn API requests (ms).
# Torn allows ~100 requests/min per user; 700ms spacing leaves headroom.
TORN_API_MIN_REQUEST_INTERVAL_MS=700
# Maximum initial history window fetched on first sync (days, max 180)
TORN_SYNC_INITIAL_HISTORY_DAYS=180

# --- Security -------------------------------------------------------------
# Master key for encrypting the Torn API key at rest (AES-256-GCM).
# REQUIRED - the app refuses to start without it. Generate a fresh 64-hex-char
# value per install (the README Quick Start commands do this automatically):
#   openssl rand -hex 32
API_KEY_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# --- App / origins ----------------------------------------------------------
# TornScope is domain-neutral: LOCALHOST defaults below work with zero setup.
# Any non-local deployment (LAN IP, reverse proxy, public domain) MUST set
# these to the address users actually open in their browser — see README
# "Running TornScope outside localhost". Misconfiguration breaks session
# cookies, CSRF/origin checks, Web Push and per-IP rate limiting.
#
# Local development example:
#   APP_BASE_URL=http://localhost:5173
#   PUBLIC_BASE_URL=
#   ALLOWED_ORIGINS=http://localhost:5173   (full origins — scheme + host + port)
#   ORIGIN=http://localhost:5173
#
# Public deployment example (https://torn.example.com):
#   APP_BASE_URL=https://torn.example.com
#   PUBLIC_BASE_URL=https://torn.example.com
#   ALLOWED_ORIGINS=https://torn.example.com
#   ORIGIN=https://torn.example.com

# Web origin used for CORS and demo links (API)
APP_BASE_URL=http://localhost:5173
# Public origin users browse. Informational; the only place it is exposed to
# browsers is a hint on the push-settings screen when the current context is
# not secure. Leave empty for pure-local development.
PUBLIC_BASE_URL=
# Comma-separated extra origins allowed for cookie-authenticated mutations
ALLOWED_ORIGINS=http://localhost:5173
# Browser-facing origin of the web app (SvelteKit). Must match what users
# actually open; falls back to APP_BASE_URL in the compose files.
ORIGIN=http://localhost:5173
# Trust X-Forwarded-* headers behind a reverse proxy. Accepted: true (one
# trusted proxy hop — the web app's own proxy), false (direct exposure), or
# a proxy-addr subnet list / preset matching the REAL proxy chain (e.g.
# "loopback", "10.0.0.0/8,192.168.0.0/16"). Hop counts are deliberately not
# supported (Fastify fails closed on them). See README.
TRUST_PROXY=true
# Real client-IP resolution for per-IP rate limits (web app → API). Leave
# unset for localhost/direct LAN access (socket address is used). Behind a
# reverse proxy set the header carrying the real client IP:
#   CLIENT_IP_HEADER=x-forwarded-for   (+ CLIENT_IP_DEPTH = number of
#   proxies that append to the chain; 1 for a single proxy like NPM)
#   CLIENT_IP_HEADER=cf-connecting-ip  (when Cloudflare is in front)
CLIENT_IP_HEADER=
CLIENT_IP_DEPTH=1
# Port the API listens on
API_PORT=3000
# Where the web app proxies API requests (server-side)
API_BASE_URL=http://localhost:3000

# --- Sync schedule overrides (seconds) -------------------------------------
SYNC_INTERVAL_PROFILE=300
SYNC_INTERVAL_EVENTS=300
SYNC_INTERVAL_DRUGS=600
SYNC_INTERVAL_TRAVEL=600
SYNC_INTERVAL_MONEY_LOGS=600
SYNC_INTERVAL_NETWORTH=3600
SYNC_INTERVAL_PERSONAL_STATS=3600
SYNC_INTERVAL_FACTION_BASIC=21600
SYNC_INTERVAL_TORN_CATALOG=86400

# --- Today (live status) ----------------------------------------------------
# How long /api/today responses are cached before Torn is hit again (ms).
# Countdowns render client-side from absolute timestamps, so this can stay low.
TODAY_CACHE_TTL_MS=30000


# --- Push notifications (Web Push / VAPID) ----------------------------------
# Generate once with: npx web-push generate-vapid-keys
# Private key stays on the server; public key is served to browsers.
# Push stays disabled until both keys are present.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info

# --- Non-local deployments ---------------------------------------------------
# Abandoned anonymous profile cleanup (days of inactivity)
GUEST_PROFILE_RETENTION_DAYS=60

# --- Hosted-instance limits (roadmap #8) ------------------------------------
# Abuse bounds for a publicly reachable instance. Defaults suit a public
# beta; loosen for a trusted self-hosted LAN. Security basics (auth, CSRF,
# SSRF, isolation) never depend on these.
# Active sessions allowed per profile (stalest revoked beyond the cap).
HOSTED_MAX_SESSIONS_PER_PROFILE=10
# Anonymous profile creations per IP per hour.
HOSTED_PROFILE_CREATIONS_PER_IP_PER_HOUR=20
# Active push devices per profile (clear error at the cap, never eviction).
HOSTED_MAX_PUSH_DEVICES=10
