# TornScope environment configuration
# Copy to .env and adjust. Never commit real secrets.

# --- Database -------------------------------------------------------------
# PostgreSQL connection string used by Prisma (api, worker, scripts)
DATABASE_URL=postgresql://tornscope:tornscope@localhost:5432/tornscope?schema=public

# --- Redis ----------------------------------------------------------------
# Used by BullMQ for the sync queue and rate-limit coordination
REDIS_URL=redis://localhost:6379

# --- Torn API -------------------------------------------------------------
# Torn API v2 base URL. Only override for testing/proxying.
TORN_API_BASE_URL=https://api.torn.com/v2
# Minimum spacing between outgoing Torn API requests (ms).
# Torn allows ~100 requests/min per user; 700ms spacing leaves headroom.
TORN_API_MIN_REQUEST_INTERVAL_MS=700
# Maximum initial history window fetched on first sync (days, max 180)
TORN_SYNC_INITIAL_HISTORY_DAYS=180

# --- Security -------------------------------------------------------------
# Master key for encrypting the Torn API key at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED - the app refuses to start without it.
API_KEY_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# --- App ------------------------------------------------------------------
# Public URL of the web app (used for links/CORS origin)
APP_BASE_URL=http://localhost:5173
# Port the API listens on
API_PORT=3000
# Where the web app proxies API requests (server-side)
API_BASE_URL=http://localhost:3000

# --- Sync schedule overrides (seconds) -------------------------------------
SYNC_INTERVAL_PROFILE=300
SYNC_INTERVAL_EVENTS=300
SYNC_INTERVAL_DRUGS=600
SYNC_INTERVAL_TRAVEL=600
SYNC_INTERVAL_MONEY_LOGS=600
SYNC_INTERVAL_NETWORTH=3600
SYNC_INTERVAL_PERSONAL_STATS=3600
SYNC_INTERVAL_FACTION_BASIC=21600
SYNC_INTERVAL_TORN_CATALOG=86400

# --- Today (live status) ----------------------------------------------------
# How long /api/today responses are cached before Torn is hit again (ms).
# Countdowns render client-side from absolute timestamps, so this can stay low.
TODAY_CACHE_TTL_MS=30000

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info

# --- Public deployment -------------------------------------------------------
# Public origin users browse (informational; cookies derive from request headers)
PUBLIC_BASE_URL=
# Comma-separated origins allowed for cookie-authenticated mutations
ALLOWED_ORIGINS=https://tornscope.example.com
# Trust X-Forwarded-* headers behind a reverse proxy (false for direct exposure)
TRUST_PROXY=true
# Abandoned anonymous profile cleanup (days of inactivity)
GUEST_PROFILE_RETENTION_DAYS=60
